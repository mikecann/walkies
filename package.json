{
  "name": "walkies-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "typecheck": "tsc -p convex --noEmit",
    "test": "vitest run",
    "lint": "eslint convex --max-warnings 0",
    "diagrams": "tsx scripts/diagrams.ts",
    "diagrams:check": "tsx scripts/diagrams.ts --check",
    "web:build": "node scripts/build-web.mjs",
    "web:serve": "node scripts/build-web.mjs && node scripts/serve-web.mjs",
    "web:upload:dev": "static-hosting upload --dist web/dist --build-command 'npm run web:build'",
    "web:upload:prod": "static-hosting upload --prod --dist web/dist --build-command 'npm run web:build'",
    "web:shots": "node scripts/web-shots.mjs",
    "web:screens": "node scripts/make-web-screens.mjs",
    "web:images": "xcrun swiftc -O scripts/make-web-images.swift -o /tmp/make-web-images && /tmp/make-web-images"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.33",
    "@ai-sdk/provider-utils": "^5.0.67",
    "@convex-dev/agent": "^0.7.8",
    "@convex-dev/auth": "2.0.0-beta.0",
    "@convex-dev/feedback": "file:vendor/convex-dev-feedback-0.0.1.tgz",
    "@convex-dev/state-machines": "file:vendor/convex-dev-state-machines-0.1.1.tgz",
    "@convex-dev/static-hosting": "^0.2.1",
    "@convex-dev/workflow": "^0.4.10",
    "@convex-dev/workpool": "^0.4.14",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.152",
    "convex": "1.47.0",
    "convex-helpers": "^0.1.129",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "0.0.61",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
